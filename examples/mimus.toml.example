# mimus.toml — per-repo critic config. Secrets (LLM provider
# keys) resolve via env var -> OS keyring -> ~/.config/mimus/env;
# never this file.

[sources]
docs = ["README.md", "docs/**/*.md", "AGENTS.md", "project/**/*.md"]
comments = true                  # extract claims from code comments
cards = ".kuda/modules/*.yaml"   # audit the memory layer itself

[check]
mechanical = true                # paths, commands, symbols, counts
semantic = false                 # prose-vs-behavior; report tier
kuda_index = ".kuda/index.sqlite"   # adapter: mimus-check-symbol — live
# base_dirs = ["infrastructure/postgres"]  # extra roots path claims resolve against
# kinds = ["path", "command"]    # restrict checked claim kinds (empty = all)
# ignore_prefixes = ["api/"]     # skip claims starting with these
# binaries = ["bun", "dagger"]   # declared prerequisites — skip the PATH probe
# [check.aliases]                # subject aliases for the contradiction
# "auth svc" = "auth"            # buckets — alias = "canonical"

[rules]
dir = "rules"                    # data-driven convention rules
# strict = true                  # fail CI on rule violations too

[report]
format = "human"                 # human | json
# min_confidence = "high"        # suppress low-evidence findings
