# ~/.config/mimus/env (chmod 600) — secrets only; everything
# else is in mimus.toml. Alternatively store them in your OS
# keyring: secret-tool store --label='mimus: NAME' service mimus name NAME
MIMUS_WEBHOOK_SECRET=
MIMUS_TOKEN=                  # repo-scoped PAT: statuses + webhook admin
# CARGO_REGISTRY_TOKEN=       # only if a repo uses scripts/release.sh
