# ~/.config/malurus/env (chmod 600) — secrets only; everything
# else is in malurus.toml. Alternatively store them in your OS
# keyring: secret-tool store --label='malurus: NAME' service malurus name NAME
MALURUS_WEBHOOK_SECRET=
MALURUS_TOKEN=                  # repo-scoped PAT: statuses + webhook admin
# CARGO_REGISTRY_TOKEN=       # only if a repo uses scripts/release.sh
